<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sidecarauto.login-ready</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LOGIN_READY_PATH__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__LOG_PATH__.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__.err.log</string>
</dict>
</plist>
